{
  "openapi": "3.1.0",
  "info": {
    "title": "Shelf Todo Example",
    "version": "0.2.0",
    "description": "A Shelf Todo API demonstrating axle_shelf."
  },
  "tags": [
    {
      "name": "System",
      "description": "Service metadata."
    },
    {
      "name": "Notes",
      "description": "Note operations."
    }
  ],
  "externalDocs": {
    "url": "https://github.com/infm5/axle",
    "description": "axle documentation."
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Check service health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/notes": {
      "get": {
        "tags": [
          "Notes"
        ],
        "summary": "List notes",
        "operationId": "listNotes",
        "parameters": [
          {
            "name": "completed",
            "in": "query",
            "description": "Filter by completion state.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of notes to return.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Note"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Notes"
        ],
        "summary": "Create a note",
        "operationId": "createNote",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateNote"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "Location": {
                "description": "URL of the created note.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/notes/activity": {
      "get": {
        "tags": [
          "Notes"
        ],
        "summary": "List note activity",
        "operationId": "noteActivity",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NoteEvent"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/notes/import": {
      "post": {
        "tags": [
          "Notes"
        ],
        "summary": "Import notes from a multipart upload",
        "operationId": "importNotes",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/NoteImport"
              }
            }
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "201": {
            "description": "The upload was accepted.",
            "headers": {
              "Location": {
                "description": "The import collection URL.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/notes/stats": {
      "get": {
        "tags": [
          "Notes"
        ],
        "summary": "Get note statistics",
        "operationId": "noteStats",
        "parameters": [
          {
            "name": "window",
            "in": "query",
            "description": "The subset used for the matching count.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "active",
                "completed"
              ],
              "default": "all"
            }
          },
          {
            "name": "session",
            "in": "cookie",
            "description": "Optional session id echoed in X-Session.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Note statistics.",
            "headers": {
              "X-Total-Count": {
                "description": "The total number of notes.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Session": {
                "description": "The session cookie value, or anonymous.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteStats"
                }
              },
              "application/vnd.axle+json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteStats"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/notes/{id}": {
      "get": {
        "tags": [
          "Notes"
        ],
        "summary": "Get a note",
        "operationId": "getNote",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The note id.",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Notes"
        ],
        "summary": "Delete a note",
        "operationId": "deleteNote",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The note id.",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Notes"
        ],
        "summary": "Update a note",
        "operationId": "updateNote",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The note id.",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateNote"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "A stable error code."
          },
          "message": {
            "type": "string",
            "description": "A human-readable message."
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "CreateNote": {
        "type": "object",
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "An optional longer description."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "The note title."
          }
        },
        "required": [
          "title"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "checkedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the check ran."
          },
          "status": {
            "type": "string",
            "description": "The service status."
          }
        },
        "required": [
          "checkedAt",
          "status"
        ]
      },
      "ImportResult": {
        "type": "object",
        "properties": {
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of bytes received."
          }
        },
        "required": [
          "bytes"
        ],
        "description": "The result of accepting an import upload."
      },
      "Note": {
        "type": "object",
        "properties": {
          "completed": {
            "type": "boolean",
            "description": "Whether the note is completed."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the note was created."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "An optional longer description."
          },
          "id": {
            "type": "integer",
            "description": "The numeric note id."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "The note title."
          }
        },
        "required": [
          "completed",
          "createdAt",
          "id",
          "title"
        ]
      },
      "NoteCompletedEvent": {
        "type": "object",
        "properties": {
          "noteId": {
            "type": "integer",
            "minimum": 1,
            "description": "The note id."
          },
          "title": {
            "type": "string",
            "description": "The note title."
          },
          "type": {
            "type": "string",
            "description": "The event discriminator."
          }
        },
        "required": [
          "noteId",
          "title",
          "type"
        ],
        "description": "A note was completed."
      },
      "NoteCreatedEvent": {
        "type": "object",
        "properties": {
          "noteId": {
            "type": "integer",
            "minimum": 1,
            "description": "The note id."
          },
          "title": {
            "type": "string",
            "description": "The note title."
          },
          "type": {
            "type": "string",
            "description": "The event discriminator."
          }
        },
        "required": [
          "noteId",
          "title",
          "type"
        ],
        "description": "A note was created."
      },
      "NoteEvent": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/NoteCreatedEvent"
          },
          {
            "$ref": "#/components/schemas/NoteCompletedEvent"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "created": "#/components/schemas/NoteCreatedEvent",
            "completed": "#/components/schemas/NoteCompletedEvent"
          }
        },
        "description": "A note activity event."
      },
      "NoteImport": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "description": "The CSV file to import."
          }
        },
        "required": [
          "file"
        ],
        "description": "A multipart note import file."
      },
      "NoteStats": {
        "type": "object",
        "properties": {
          "active": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of active notes."
          },
          "completed": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of completed notes."
          },
          "matching": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of notes matching [window]."
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "description": "The total number of notes."
          },
          "window": {
            "type": "string",
            "description": "The selected window."
          }
        },
        "required": [
          "active",
          "completed",
          "matching",
          "total",
          "window"
        ],
        "description": "A summary of notes for a selected window."
      },
      "UpdateNote": {
        "type": "object",
        "properties": {
          "completed": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "The new completion state."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "The new description."
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 120,
            "description": "The new title."
          }
        }
      }
    },
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "description": "Example API key. Send demo-key in local runs.",
        "name": "X-API-Key",
        "in": "header"
      }
    }
  }
}
