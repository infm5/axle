{
  "openapi": "3.1.0",
  "info": {
    "title": "Relic Todo API",
    "version": "0.2.0",
    "description": "A proper Relic Todo API demonstrating axle.",
    "contact": {
      "name": "Axle Example",
      "email": "example@example.com"
    },
    "license": {
      "name": "MIT"
    }
  },
  "tags": [
    {
      "name": "System",
      "description": "Service metadata."
    },
    {
      "name": "Todos",
      "description": "Todo operations."
    }
  ],
  "externalDocs": {
    "url": "https://github.com/infm5/axle",
    "description": "axle documentation."
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Check service health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/todos": {
      "get": {
        "tags": [
          "Todos"
        ],
        "summary": "List todos",
        "operationId": "listTodos",
        "parameters": [
          {
            "name": "completed",
            "in": "query",
            "description": "Filter by completion state.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of todos to return.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Todo"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Todos"
        ],
        "summary": "Create a todo",
        "operationId": "createTodo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTodo"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "Location": {
                "description": "URL of the created todo.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Todo"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/todos/activity": {
      "get": {
        "tags": [
          "Todos"
        ],
        "summary": "List todo activity",
        "operationId": "todoActivity",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TodoEvent"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/todos/import": {
      "post": {
        "tags": [
          "Todos"
        ],
        "summary": "Import todos from a multipart upload",
        "operationId": "importTodos",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/TodoImport"
              }
            }
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "201": {
            "description": "The upload was accepted.",
            "headers": {
              "Location": {
                "description": "The import collection URL.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/todos/stats": {
      "get": {
        "tags": [
          "Todos"
        ],
        "summary": "Get todo statistics",
        "operationId": "todoStats",
        "parameters": [
          {
            "name": "window",
            "in": "query",
            "description": "The subset used for the matching count.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "active",
                "completed"
              ],
              "default": "all"
            }
          },
          {
            "name": "session",
            "in": "cookie",
            "description": "Optional session id echoed in X-Session.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Todo statistics.",
            "headers": {
              "X-Total-Count": {
                "description": "The total number of todos.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Session": {
                "description": "The session cookie value, or anonymous.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodoStats"
                }
              },
              "application/vnd.axle+json": {
                "schema": {
                  "$ref": "#/components/schemas/TodoStats"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/todos/{id}": {
      "get": {
        "tags": [
          "Todos"
        ],
        "summary": "Get a todo",
        "operationId": "getTodo",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The todo id.",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Todo"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Todos"
        ],
        "summary": "Delete a todo",
        "operationId": "deleteTodo",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The todo id.",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Todos"
        ],
        "summary": "Update a todo",
        "operationId": "updateTodo",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The todo id.",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTodo"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Todo"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "A stable machine-readable error code."
          },
          "message": {
            "type": "string",
            "description": "A human-readable error message."
          }
        },
        "required": [
          "code",
          "message"
        ],
        "description": "An API error."
      },
      "CreateTodo": {
        "type": "object",
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "An optional longer description."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "The todo title."
          }
        },
        "required": [
          "title"
        ],
        "description": "The request body for creating a todo."
      },
      "Health": {
        "type": "object",
        "properties": {
          "checked_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the check was performed."
          },
          "status": {
            "type": "string",
            "description": "The service status."
          }
        },
        "required": [
          "checked_at",
          "status"
        ],
        "description": "A health check response."
      },
      "ImportResult": {
        "type": "object",
        "properties": {
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of bytes received."
          }
        },
        "required": [
          "bytes"
        ],
        "description": "The result of accepting an import upload."
      },
      "Todo": {
        "type": "object",
        "properties": {
          "completed": {
            "type": "boolean",
            "description": "Whether the todo is complete."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the todo was created."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "An optional longer description."
          },
          "id": {
            "type": "integer",
            "description": "The numeric id."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "The todo title."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the todo was last updated."
          }
        },
        "required": [
          "completed",
          "created_at",
          "id",
          "title",
          "updated_at"
        ],
        "description": "A todo item."
      },
      "TodoCompletedEvent": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The todo title."
          },
          "todo_id": {
            "type": "integer",
            "minimum": 1,
            "description": "The todo id."
          },
          "type": {
            "type": "string",
            "description": "The event discriminator."
          }
        },
        "required": [
          "title",
          "todo_id",
          "type"
        ],
        "description": "A todo was completed."
      },
      "TodoCreatedEvent": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The todo title."
          },
          "todo_id": {
            "type": "integer",
            "minimum": 1,
            "description": "The todo id."
          },
          "type": {
            "type": "string",
            "description": "The event discriminator."
          }
        },
        "required": [
          "title",
          "todo_id",
          "type"
        ],
        "description": "A todo was created."
      },
      "TodoEvent": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/TodoCreatedEvent"
          },
          {
            "$ref": "#/components/schemas/TodoCompletedEvent"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "created": "#/components/schemas/TodoCreatedEvent",
            "completed": "#/components/schemas/TodoCompletedEvent"
          }
        },
        "description": "A todo activity event."
      },
      "TodoImport": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "description": "The CSV file to import."
          }
        },
        "required": [
          "file"
        ],
        "description": "A multipart todo import file."
      },
      "TodoStats": {
        "type": "object",
        "properties": {
          "active": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of active todos."
          },
          "completed": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of completed todos."
          },
          "matching": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of todos matching [window]."
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "description": "The total number of todos."
          },
          "window": {
            "type": "string",
            "description": "The selected window."
          }
        },
        "required": [
          "active",
          "completed",
          "matching",
          "total",
          "window"
        ],
        "description": "A summary of todos for a selected window."
      },
      "UpdateTodo": {
        "type": "object",
        "properties": {
          "completed": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "The new completion state, when changing it."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "The new description, when changing it."
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 120,
            "description": "The new title, when changing it."
          }
        },
        "description": "The request body for updating a todo."
      }
    },
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "description": "Example API key. Send demo-key in local runs.",
        "name": "X-API-Key",
        "in": "header"
      }
    }
  }
}
