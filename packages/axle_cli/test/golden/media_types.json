{
  "openapi": "3.1.0",
  "info": {
    "title": "Golden media_types",
    "version": "1.0.0"
  },
  "paths": {
    "/documents/{id}": {
      "patch": {
        "operationId": "patchDocument",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/merge-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/MergePatch"
              }
            },
            "application/json-patch+json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/PatchOperation"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/raw": {
      "put": {
        "operationId": "raw",
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "format": "byte"
                }
              }
            }
          },
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Blob"
                }
              }
            }
          }
        }
      }
    },
    "/report": {
      "get": {
        "operationId": "report",
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/upload": {
      "post": {
        "operationId": "upload",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Upload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Blob": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "byte",
            "description": "Bytes inside JSON are base64 text."
          }
        },
        "required": [
          "data"
        ]
      },
      "MergePatch": {
        "type": "object",
        "properties": {
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PatchOperation": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "op",
          "path"
        ]
      },
      "Report": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "integer"
          }
        },
        "required": [
          "rows"
        ]
      },
      "Upload": {
        "type": "object",
        "properties": {
          "attachments": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "binary"
            }
          },
          "cover": {
            "type": "string",
            "format": "binary"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "attachments",
          "cover",
          "title"
        ]
      }
    }
  }
}
